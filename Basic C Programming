2.Read the radius of a circle and find its area and circumference.

#include <stdio.h>

int main()
{
    float r, area, circumference;

    scanf("%f", &r);

    area = 3.14 * r * r;
    circumference = 2 * 3.14 * r;

    printf("Area = %.2f\n", area);
    printf("Circumference = %.2f\n", circumference);

    return 0;
}
3. Read marks of 5 subjects and calculate total and average.

#include <stdio.h>

int main() {
    float marks[5], total = 0, average;
    int i;

    printf("Enter marks of 5 subjects:\n");

    for (i = 0; i < 5; i++) {
        scanf("%f", &marks[i]);
        total += marks[i];
    }

    average = total / 5;

    printf("Total = %.2f\n", total);
    printf("Average = %.2f\n", average);

    return 0;
}
4. Swap two numbers using a third variable.
#include <stdio.h>

int main() {
    int a, b, temp;

    printf("Enter two numbers: ");
    scanf("%d %d", &a, &b);

    temp = a;
    a = b;
    b = temp;

    printf("After swapping:\n");
    printf("a = %d\n", a);
    printf("b = %d\n", b);

    return 0;
}
5. Swap two numbers without using a third variable.
#include <stdio.h>

int main() {
    int a, b;

    printf("Enter two numbers: ");
    scanf("%d %d", &a, &b);

    a = a + b;
    b = a - b;
    a = a - b;

    printf("After swapping:\n");
    printf("a = %d\n", a);
    printf("b = %d\n", b);

    return 0;
}

