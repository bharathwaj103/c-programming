30. Find the largest element in an array.
#include <stdio.h>

int main()
{
    int a[100], n, largest;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    largest = a[0];

    for (int i = 1; i < n; i++)
    {
        if (a[i] > largest)
            largest = a[i];
    }

    printf("Largest element = %d", largest);

    return 0;
}

