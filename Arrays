32. Find the sum and average of array elements.
#include <stdio.h>

int main()
{
    int a[100], n, sum = 0;
    float average;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for (int i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
        sum += a[i];
    }

    average = (float)sum / n;

    printf("Sum = %d\n", sum);
    printf("Average = %.2f", average);

    return 0;
}

33. Count the number of even and odd elements in an array.
#include <stdio.h>

int main()
{
    int a[100], n, even = 0, odd = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for (int i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);

        if (a[i] % 2 == 0)
            even++;
        else
            odd++;
    }

    printf("Even elements = %d\n", even);
    printf("Odd elements = %d", odd);

    return 0;
}

34. Search for an element in an array.
#include <stdio.h>

int main()
{
    int a[100], n, search, found = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter element to search: ");
    scanf("%d", &search);

    for (int i = 0; i < n; i++)
    {
        if (a[i] == search)
        {
            printf("Element found at position %d", i + 1);
            found = 1;
            break;
        }
    }

    if (!found)
        printf("Element not found.");

    return 0;
}

35. Reverse the elements of an array.
#include <stdio.h>

int main()
{
    int a[100], n;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Reversed array: ");

    for (int i = n - 1; i >= 0; i--)
        printf("%d ", a[i]);

    return 0;
}

36. Find the second largest element in an array.
#include <stdio.h>
#include <limits.h>

int main()
{
    int a[100], n;
    int largest = INT_MIN, second = INT_MIN;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    for (int i = 0; i < n; i++)
    {
        if (a[i] > largest)
        {
            second = largest;
            largest = a[i];
        }
        else if (a[i] > second && a[i] != largest)
        {
            second = a[i];
        }
    }

    if (second == INT_MIN)
        printf("Second largest element does not exist.");
    else
        printf("Second largest element = %d", second);

    return 0;
}

37. Count the frequency of a given element in an array.
#include <stdio.h>

int main()
{
    int a[100], n, element, count = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter element: ");
    scanf("%d", &element);

    for (int i = 0; i < n; i++)
    {
        if (a[i] == element)
            count++;
    }

    printf("Frequency of %d = %d", element, count);

    return 0;
}

